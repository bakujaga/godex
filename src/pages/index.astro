---
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxgizXSrGnrjND4XS0u7gUTA2z9RjLHeJHRxmtsY3J_RskrTZeaEuOvL2cgVYC_42FXxg/exec";
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yellow Pages Gorontalo - Godex</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Direktori Usaha Gorontalo</h1>
        <p class="text-gray-600">Temukan kontak dan alamat tempat usaha di Gorontalo.</p>
      </div>
      <a href="/tambah" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-md text-sm shadow-sm">
        + Tambah Tempat
      </a>
    </div>

    <!-- State Loading -->
    <div id="loading" class="text-center py-10 text-gray-500 font-medium">
      Memuat data tempat usaha...
    </div>

    <!-- Grid Tempat Usaha -->
    <div id="placesGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4 hidden"></div>

    <!-- State Kosong -->
    <div id="emptyMsg" class="text-gray-500 text-center py-10 hidden">
      Belum ada data tempat usaha.
    </div>
  </div>

  <script define:vars={{ SCRIPT_URL }}>
    async function loadPlaces() {
      const loadingEl = document.getElementById('loading');
      const gridEl = document.getElementById('placesGrid');
      const emptyEl = document.getElementById('emptyMsg');

      try {
        const response = await fetch(SCRIPT_URL, { redirect: 'follow' });
        const places = await response.json();

        loadingEl.classList.add('hidden');

        if (places && places.length > 0) {
          gridEl.innerHTML = places.map(place => `
            <div class="bg-white p-5 rounded-lg shadow-sm border border-gray-200">
              <span class="text-xs font-semibold uppercase tracking-wide bg-blue-100 text-blue-800 px-2 py-1 rounded">
                ${place['Kategori'] || 'Lainnya'}
              </span>
              <h2 class="text-xl font-bold text-gray-800 mt-2">${place['Nama Tempat'] || '-'}</h2>
              <p class="text-gray-600 text-sm mt-1">${place['Alamat Lengkap'] || '-'}</p>
              
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700">No: ${place['Nomor Telp'] || '-'}</span>
                
                ${place['Link Google Maps'] ? `
                  <a 
                    href="${place['Link Google Maps']}" 
                    target="_blank" 
                    class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-2 rounded font-medium"
                  >
                    Buka Maps &rarr;
                  </a>
                ` : ''}
              </div>
            </div>
          `).join('');

          gridEl.classList.remove('hidden');
        } else {
          emptyEl.classList.remove('hidden');
        }
      } catch (err) {
        console.error("Gagal memuat data:", err);
        loadingEl.textContent = "Gagal memuat data tempat. Periksa koneksi atau URL Apps Script.";
      }
    }

    loadPlaces();
  </script>
</body>
</html>